#!/bin/sh
# Refuse any commit message carrying AI attribution: a Co-Authored-By for an AI
# would list it as a contributor on GitHub, and the other lines are noise.
if grep -i -E -q '^(Co-Authored-By:.*(claude|anthropic|copilot|gpt|openai)|Claude-Session:|.*Generated with \[?Claude)' "$1"; then
    echo "commit-msg: AI attribution line found — remove it:" >&2
    grep -i -n -E '^(Co-Authored-By:.*(claude|anthropic|copilot|gpt|openai)|Claude-Session:|.*Generated with \[?Claude)' "$1" >&2
    exit 1
fi
