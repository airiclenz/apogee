{
    "##": "Generated by cmd/release in airiclenz/apogee and overwritten at each release: edit cmd/release/templates/scoop.json.tmpl there, never this file.",
    "version": "{{.Version}}",
    "description": "A terminal AI coding agent built for smaller, locally hosted LLMs",
    "homepage": "https://github.com/airiclenz/apogee",
    "license": "MIT",
    "architecture": {
{{- with .Archive "windows" "amd64"}}
        "64bit": {
            "url": "{{.URL}}",
            "hash": "{{.SHA256}}",
            "extract_dir": "{{.Stem}}"
        },
{{- end}}
{{- with .Archive "windows" "arm64"}}
        "arm64": {
            "url": "{{.URL}}",
            "hash": "{{.SHA256}}",
            "extract_dir": "{{.Stem}}"
        }
{{- end}}
    },
    "bin": "apogee.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/airiclenz/apogee/releases/download/v$version/apogee_$version_windows_amd64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                },
                "extract_dir": "apogee_$version_windows_amd64"
            },
            "arm64": {
                "url": "https://github.com/airiclenz/apogee/releases/download/v$version/apogee_$version_windows_arm64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                },
                "extract_dir": "apogee_$version_windows_arm64"
            }
        }
    }
}
