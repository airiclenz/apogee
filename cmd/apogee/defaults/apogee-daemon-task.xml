<?xml version="1.0" encoding="UTF-16"?>
<!--
  apogee daemon — generated by `apogee daemon install`.

  Every value below is a fact about the host this was generated on: the absolute path of
  the apogee binary and the apogee home when one was pinned at install time. Re-run
  `apogee daemon install` after changing shutdown-grace or moving the binary; editing this
  file by hand works, but the next install overwrites it, and the Task Scheduler keeps its
  own copy from the moment the task is registered.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>apogee daemon — the scheduled prompts declared in schedules.yaml.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <!--
    The Task Scheduler has no stop-grace setting of its own: when the task is ended it asks
    the process to close and hard-terminates what is left. apogee owns the escalation
    instead — the first stop request gives a firing already in flight up to shutdown-grace
    ({{.Grace}}) to finish, and the daemon is gone within {{.StopWindow}}.
  -->
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{.Command}}</Command>
      <Arguments>{{.Arguments}}</Arguments>
    </Exec>
  </Actions>
</Task>
