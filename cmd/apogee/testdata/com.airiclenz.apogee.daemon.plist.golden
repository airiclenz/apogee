<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  apogee daemon — generated by `apogee daemon install`.

  Every value below is a fact about the host this was generated on: the absolute path of
  the apogee binary, the apogee home when one was pinned at install time, and ExitTimeOut
  derived from shutdown-grace in schedules.yaml. Re-run `apogee daemon install` after
  changing shutdown-grace or moving the binary; editing this file by hand works, but the
  next install overwrites it.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.airiclenz.apogee.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/apogee/bin/apogee</string>
		<string>daemon</string>
		<string>--config</string>
		<string>/home/tester/.apogee</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<!-- launchd's SIGTERM-to-SIGKILL escalation: shutdown-grace plus 30 seconds, so the
	     daemon gets its whole grace before launchd stops asking nicely. -->
	<key>ExitTimeOut</key>
	<integer>630</integer>
	<!-- launchd journals nothing on its own, so the daemon's narration is appended here.
	     Rotation is the host's: add it to newsyslog if the file grows. -->
	<key>StandardOutPath</key>
	<string>/home/tester/.apogee/daemon/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/home/tester/.apogee/daemon/daemon.log</string>
</dict>
</plist>
