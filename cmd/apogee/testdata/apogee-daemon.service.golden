# apogee daemon — generated by `apogee daemon install`.
#
# Every value below is a fact about the host this was generated on: the absolute path of
# the apogee binary, the apogee home when one was passed with --config, and the stop
# timeout derived from shutdown-grace in schedules.yaml. Re-run `apogee daemon install`
# after changing shutdown-grace or moving the binary; editing this file by hand works,
# but the next install overwrites it.

[Unit]
Description=apogee daemon — the scheduled prompts declared in schedules.yaml
Documentation=https://github.com/airiclenz/apogee
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/opt/apogee/bin/apogee daemon --config /home/tester/.apogee
# The daemon narrates on stdout and never rotates anything: the journal keeps the lines
# and retention is systemd's business, not apogee's.
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=30s
# The first SIGTERM stops the clock and gives a firing already in flight up to
# shutdown-grace to finish. KillMode=mixed keeps that signal off the tool processes the
# firing is still running, so only the daemon itself is asked to wind down.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=630

[Install]
WantedBy=default.target
